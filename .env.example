# Google Gemini API Key
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
VITE_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
VITE_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Paystack Frontend Checkout
# Use your Paystack public key here. Never expose your secret key in the frontend.
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Plan amounts in kobo (e.g. NGN 5,000 = 500000)
VITE_PAYSTACK_MONTHLY_AMOUNT_KOBO=500000
VITE_PAYSTACK_YEARLY_AMOUNT_KOBO=5000000
VITE_PAYSTACK_LIFETIME_AMOUNT_KOBO=25000000

# Optional labels shown on the premium screen
VITE_PAYSTACK_MONTHLY_LABEL=NGN 5,000 / month
VITE_PAYSTACK_YEARLY_LABEL=NGN 50,000 / year
VITE_PAYSTACK_LIFETIME_LABEL=NGN 250,000 one-time
